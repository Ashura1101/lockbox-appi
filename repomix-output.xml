/* Reset y variables base */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  width: 360px;
  min-height: 520px;
  background-color: #0b0f19;
  color: #f8fafc;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  padding: 16px;
}

.app-container {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

/* Header */
.app-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo-title {
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 1px;
  color: #818cf8;
}

.badge-status {
  background: rgba(99, 102, 241, 0.15);
  color: #818cf8;
  border: 1px solid rgba(99, 102, 241, 0.3);
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 11px;
  font-weight: 600;
}

/* Navegación Pestañas */
.tabs-nav {
  display: flex;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 10px;
  padding: 4px;
  gap: 4px;
}

.tab-btn {
  flex: 1;
  background: transparent;
  border: none;
  color: #94a3b8;
  padding: 8px 12px;
  font-size: 13px;
  font-weight: 600;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.tab-btn.active {
  background: #6366f1;
  color: #ffffff;
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
}

/* Formulario e Inputs */
.input-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 12px;
}

.input-label {
  font-size: 12px;
  font-weight: 600;
  color: #cbd5e1;
}

.password-wrapper,
.search-wrapper,
.generator-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

input[type="text"],
input[type="password"],
.input-field {
  width: 100%;
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  padding: 10px 12px;
  color: #ffffff;
  font-size: 13px;
  font-family: inherit;
  transition: border-color 0.2s;
}

input[type="text"]:focus,
input[type="password"]:focus,
.input-field:focus {
  outline: none;
  border-color: #6366f1;
}

/* Iconos y Botones de Formulario */
.icon-button {
  position: absolute;
  right: 10px;
  background: none;
  border: none;
  color: #94a3b8;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-eye {
  width: 18px;
  height: 18px;
}

.btn-primary {
  width: 100%;
  background: #6366f1;
  color: #ffffff;
  border: none;
  border-radius: 8px;
  padding: 12px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: background 0.2s, transform 0.1s;
  margin-top: 6px;
}

.btn-primary:hover {
  background: #4f46e5;
}

.btn-primary:active {
  transform: scale(0.98);
}

.icon-search {
  width: 16px;
  height: 16px;
}

/* Generador */
.separator {
  height: 1px;
  background: rgba(255, 255, 255, 0.08);
  margin: 16px 0;
}

.length-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
  color: #94a3b8;
  margin-bottom: 6px;
}

.length-container input[type="range"] {
  accent-color: #6366f1;
  cursor: pointer;
}

.generator-actions {
  position: absolute;
