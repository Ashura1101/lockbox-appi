{
  "manifest_version": 3,
  "name": "Lockbox Password Manager",
  "version": "1.0",
  "description": "Extensión de Chrome para el Gestor de Contraseñas LOCKBOX",
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://lockbox-appi.onrender.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}